# Copy to .env and fill in. Never commit .env.
PORT=3006
ENVIRONMENT=production
LOG_LEVEL=INFO

# Same JWT_SECRET as auth-service/gateway; same INTERNAL_SERVICE_TOKEN everywhere
JWT_SECRET=change-me
INTERNAL_SERVICE_TOKEN=change-me
CORS_ORIGINS=http://16.171.146.196,http://localhost:5173

POSTGRES_HOST=ceoos-postgres
POSTGRES_PORT=5432
POSTGRES_DB=insight_db
POSTGRES_USER=ceoos_admin
POSTGRES_PASSWORD=change-me
POSTGRES_SSL=false

REDIS_HOST=ceoos-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

KAFKA_BOOTSTRAP_SERVERS=ceoos-kafka:9092
KAFKA_SSL=false
KAFKA_TRANSACTIONS_TOPIC=transactions
KAFKA_FRAUD_ALERTS_TOPIC=fraud-alerts

# Optional: enables AI-written summaries
OPENAI_API_KEY=

# Reliability
# MemoryDB / ElastiCache with cluster mode enabled
REDIS_CLUSTER=false
# Apply the schema at startup. In Kubernetes the migration Job does it: set false there.
RUN_MIGRATIONS=true
# Optional SASL for MSK (e.g. SCRAM-SHA-512)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
